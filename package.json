{
  "name": "soborbo-tracking-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "check:contract": "node scripts/contract-hash.mjs --check",
    "check:roundtrip": "node scripts/roundtrip-check.mjs",
    "check:docs": "node scripts/check-doc-truth.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "compliance": "node tests/compliance/run.mjs",
    "compliance:selftest": "node tests/compliance/selftest/run-selftest.mjs",
    "check:lockfile": "node scripts/check-lockfile-complete.mjs package-lock.json && node scripts/check-lockfile-complete.mjs soborbo-tracking/package-lock.json",
    "gen:error-codes": "node --experimental-transform-types --no-warnings scripts/gen-error-code-table.mjs",
    "check:error-codes": "node --experimental-transform-types --no-warnings scripts/gen-error-code-table.mjs --check && node --experimental-transform-types --no-warnings scripts/check-error-code-emission.mjs",
    "check:engine-events": "node server/check-event-contract.mjs",
    "check:live-gtm": "node --experimental-transform-types --no-warnings --import ./scripts/lib/ts-resolve-hook.mjs scripts/check-live-gtm.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260717.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
